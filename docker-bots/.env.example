# ── Zoom Meeting Config ──
MEETING_URL=https://zoom.us/j/YOUR_MEETING_ID?pwd=YOUR_PASSWORD
BOT_NAME=Participant
CHAT_INTERVAL_MIN=15
CHAT_INTERVAL_MAX=45

# ── Chat Messages (JSON array) ──
CHAT_MESSAGES=["Hi everyone!","Can you hear me?","Great presentation!","Interesting point.","Thanks for sharing.","I agree with that.","Sorry I am late.","Good morning!","Sounds good to me.","Thanks for the update."]

# ── Execution ──
HEADLESS=true
BOT_TIMEOUT=3600
